# Fixed IP address in an external network: dev1-net
#
# FIXED_SUBNET=172.40.0.0/24
# This makes the IP range 172.40.0.1 till 172.40.0.254 available (254 IP addresses)
#
# External Network must exist or be created before the container is created
# To create this external network, run one of the following commands:
#    docker network create --subnet=${FIXED_SUBNET} dev1-net
#    docker network create --subnet=172.40.0.0/24 dev1-net

# Other related commands:
#    docker network ls                  # Displays all networks
#    docker network rm dev1-net        # Remove
#    docker network prune              # CAREFUL: removes all unused networks!
#    docker network inspect dev1-net   # Details
#    hostname -I                       # Check host IP in container (in bash)

# Make sure to use another subnet if you have a conflict with your local network
FIXED_SUBNET=172.40.0.0/24      # Subnet for 254 IPs (usable, 172.40.0.1 till: 172.40.0.254)
                                # Network Address: 172.40.0.0 Broadcast Address: 172.40.0.255

FIXED_IP=172.40.0.2
FIXED_IP2=172.40.0.3
FIXED_IP5=172.40.0.6
FIXED_IP6=172.40.0.7
FIXED_IP13=172.40.0.14          # Default defined: MSSQL container: mssql
FIXED_IP14=172.40.0.15          # Default defined: MSSQL init container: mssql-init

# Microsoft SQL Server settings
MSSQL_PID=Developer
MSSQL_PORT=1433
MSSQL_HOST_PORT=14330
MSSQL_SA_PASSWORD=DockerMssql123!
MSSQL_DATABASE=docker
MSSQL_USER=docker
MSSQL_PASSWORD=DockerUser123!